#include <winver.h>
#include "resource.h"

#pragma code_page(65001)

IDI_APP_ICON ICON "app.ico"
IDI_LOCKED_FOLDER_ICON ICON "folder_lock.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,1,0
 PRODUCTVERSION 2,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "yinchaow & Gemini\0"
            VALUE "FileDescription", "目录密匣 - 目录密码访问管理工具\0"
            VALUE "FileVersion", "2.1.1.0\0"
            VALUE "InternalName", "dirlocker\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 yinchaow & Gemini\0"
            VALUE "OriginalFilename", "dirlocker.exe\0"
            VALUE "ProductName", "目录密匣 (DirLocker)\0"
            VALUE "ProductVersion", "2.1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
